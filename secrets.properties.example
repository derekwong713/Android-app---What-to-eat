# PUBLIC: copied into APK. Use only Supabase publishable key or legacy anon JWT.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLIC_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Optional public AdMob App ID for testing your configured UMP message.
# Debug/demo ad UNIT IDs always remain official test units, regardless of this App ID.
ADMOB_CONSENT_TEST_APP_ID=
# Live release only.
ADMOB_APP_ID=
ADMOB_BANNER_ID=
ADMOB_APP_OPEN_ID=
# Free static hosting URLs after publishing reviewed pages under web/.
PRIVACY_POLICY_URL=
TERMS_URL=
# NEVER add service_role, sb_secret_, Google/Facebook client secrets or signing keys here.
